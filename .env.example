# Скопируй в .env и заполни после деплоя analytics-сервиса (см. portfolio-analytics).
# Пока файл не создан/пуст — beacon на сайте отключён и ничего не отправляет.
VITE_ANALYTICS_URL=
VITE_ANALYTICS_KEY=

# Форма: отправка через Cloudflare Worker (worker/README.md → POST /contact).
# Без этих переменных форма откроет почтовый клиент (mailto) — это штатный режим.
VITE_CONTACT_ENDPOINT=
VITE_WEB3FORMS_KEY=
